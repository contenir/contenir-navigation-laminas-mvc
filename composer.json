{
    "name": "contenir/contenir-navigation-laminas-mvc",
    "description": "Draws a Contenir site's managed menus in laminas-mvc: each live menu as a Laminas Navigation container, record links addressed through the router, cached by revision.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contenir",
        "cms",
        "navigation",
        "menu",
        "laminas-navigation",
        "laminas-mvc"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-navigation": "^0.2",
        "laminas/laminas-navigation": "^2.23",
        "laminas/laminas-router": "^3.13",
        "laminas/laminas-servicemanager": "^3.22 || ^4.0",
        "laminas/laminas-view": "^2.35",
        "psr/container": "^1.1 || ^2.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "contenir/contenir-resource": "^2.0@RC",
        "contenir/contenir-resource-laminas-mvc": "^2.0@RC",
        "contenir/contenir-workflow-laminas-mvc": "^2.1",
        "infection/infection": "^0.35.6",
        "laminas/laminas-cache": "^3.14.1",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.5",
        "laminas/laminas-serializer": "^2.18",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "contenir/contenir-resource-laminas-mvc": "For WorkflowRecordLinks: address a menu's records through the workflows that route them",
        "contenir/contenir-workflow-laminas-mvc": "For WorkflowRecordLinks: address a menu's records through the workflows that route them",
        "laminas/laminas-cache": "To keep the menus in a laminas-cache storage"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Navigation\\Laminas\\Mvc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Navigation\\Laminas\\Mvc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.3.99"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laminas": {
            "module": "Contenir\\Navigation\\Laminas\\Mvc"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
